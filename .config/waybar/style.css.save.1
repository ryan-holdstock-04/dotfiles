#workspaces {
  border: none;
  margin: 0px 0px;
  padding: 0px 5px;
  min-width: 0px;
  color: mix(@color2, #ffffff, 0.5);
  transition: all 0.2s ease;
}

#workspaces button {
  border: none;
  min-width: 0px;
  min-height: 0px;
  margin: 0px 1px;
  padding: 0px 5px;
  color: mix(#ffffff, @color2, 0.5);
  transition: all 0.2s ease;
}

#workspaces button.active {
  padding: 0px 5px;
  color: mix(#000000, @color2, 0.5);
  border: none;
  background:mix(#ffffff, @color2, 0.5);

}

#workspaces button:hover {
  padding: 0px 5px;
  color: mix(#ffffff, @color2, 0);
  border: none;
  background:alpha(mix(#ffffff, @color1, 0.5),.3);
  box-shadow:none;
  text-shadow:none;

}

#workspaces button.active:hover {
  padding: 0px 5px;
  color: mix(#ffffff, @color2, 0);
  border: none;
  background:alpha(mix(#ffffff, @color1, 0.5),.7);
  box-shadow:none;
  text-shadow:none;
}

#battery {
  color: mix(@color2, #ffffff, 0.5);
  margin: 0px 0px;
  padding: 0px 10px 0px 10px;
}

#pulseaudio {
  color: mix(@color2, #ffffff, 0.5);
  margin: 0px 0px;
  padding: 0px 10px 0px 10px;
}

#bluetooth {
  color: mix(@color2, #ffffff, 0.5);
  margin: 0px 0px;
  padding: 0px 10px 0px 10px;
}

#idle_inhibitor {
  color: mix(@color2, #ffffff, 0.5);
  margin: 0px 0px;
  padding: 1px 17px 0px 10px;
  transition: all 0.2s ease;
}

#network {
  color: mix(@color2, #ffffff, 0.5);
  margin: 0px 0px;
  padding: 0px 10px 0px 10px;
}
