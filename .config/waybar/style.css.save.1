@import url("../../.cache/wal/colors-waybar.css");

@define-color color2color2 mix(@color2,@color2,.5);
@define-color color2color3 mix(@color2,@color3,.5);

@define-color color2color2in33 mix(@color2,@color2,.33);
@define-color color2color2in66 mix(@color2,@color2,.66);

@define-color light mix(@color2color2in33, #000000,.05);
@define-color medium mix(@color2color2in66, #000000,.1);
@define-color dark mix(@color2,#000000,.15);

* {
  font-size: 15px;
  font-family: "Fira Code Light","Font Awesome 6 Free Solid", sans-serif;
}

window#waybar {
  background-color: alpha(mix(@color1, #000000, 0.5), 1);
}

.modules-left {
  padding: 0px 0px;
  margin:3px;
}

.modules-center {
  padding: 0px 0px;
  margin:3px;
}

.modules-right {
  padding: 0px 0px 0px 0px;
  margin:0px;
}

tooltip {
  background: @background;
  color: @color7;
}

#language:hover,
#disk:hover,
#custom-note:hover,
#custom-wallpaper:hover,
#custom-pacman:hover,
#custom-notification:hover,
#bluetooth:hover,
#network:hover,
#battery:hover,
#cpu:hover,
#memory:hover,
#temperature:hover {
  padding: 0px 10px 0px 10px;
  color: mix(#ffffff, @color2, 0);
  background:alpha(mix(#ffffff, @color1, 0.5),.3);
  box-shadow:none;
  text-shadow:none;
  transition: all 0.2s ease;
}

#custom-colorpicker:hover {
  padding: 0px 13px 0px 10px;
  color: mix(#ffffff, @color2, 0);
  background:alpha(mix(#ffffff, @color1, 0.5),.3);
  box-shadow:none;
  text-shadow:none;
  transition: all 0.2s ease;
}

#custom-colorpicker {
  color: mix(@color2, #ffffff, 0.5);
  margin: 0px 0px;
  padding: 0px 13px 0px 10px;
  transition: all 0.2s ease;
}

#idle_inhibitor:hover {
  padding: 1px 17px 0px 10px;
  color: mix(#ffffff, @color2, 0);
  background:alpha(mix(#ffffff, @color1, 0.5),.3);
  box-shadow:none;
  text-shadow:none;
  transition: all 0.2s ease;
}

#pulseaudio:hover {
  padding: 0px 10px 0px 10px;
  color: mix(#ffffff, @color2, 0);
  background:alpha(mix(#ffffff, @color1, 0.5),.3);
  box-shadow:none;
  text-shadow:none;
  transition: all 0.2s ease;
}

#clock.2:hover {
  padding: 2px 10px 0px 10px;
  color: mix(#ffffff, @color2, 0);
  background:alpha(mix(#ffffff, @color1, 0.5),.3);
  box-shadow:none;
  text-shadow:none;
  transition: all 0.2s ease;
}

#language {
  color: mix(@color2, #ffffff, 0.5);
  margin: 0px 0px;
  padding: 0px 10px 0px 10px;
}
#mpris:hover {
  padding: 1px 15px 0px 15px;
  color: mix(#ffffff, @color2, 0);
  border-radius:5px;
  background:alpha(mix(#ffffff, @color1, 0.5),.3);
  box-shadow:none;
  text-shadow:none;
  transition: all 0.2s ease;
}

#clock:hover {
  padding: 2px 5px 0px 5px;
  color: mix(#ffffff, @color2, 0);
  border-radius:5px;
  background:alpha(mix(#ffffff, @color1, 0.5),.3);
  box-shadow:none;
  text-shadow:none;
}

#clock {
  margin: 0px 0px 0px 0px;
  padding: 2px 5px 0px 5px;
  border-radius:5px;
  font-size: 15px;
  color: mix(@color2, #ffffff, 0.5);
  transition: all 0.2s ease;
  border-radius:0px
}

#clock.2 {
  margin: 0px 0px 0px 0px;
  padding: 2px 10px 0px 10px;
  border-radius:5px;
  font-size: 15px;
  color: mix(@color2, #ffffff, 0.5);
  transition: all 0.2s ease;
  border-radius:0px
}

#mpris {
  margin: 0px 0px 0px 0px;
  padding: 1px 15px 0px 15px;
  transition: all 0.2s ease;
  color: mix(#ffffff, @color2, 0.5);
}

